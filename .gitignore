# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ===== 生成产物（graphify 知识图谱，可重新生成） =====
graphify-out/

# ===== 编辑器 / 系统 =====
.DS_Store
.idea/
.vscode/

# ===== 项目本地数据（不入库） =====
.codebuddy/

# ===== 密钥 / 环境 =====
.env
*.local.yaml
# 远程桥接：仅含 QQ 凭证的文件不入库
flask_server/config/remote_bridge.yaml
flask_server/config/remote_bridge.yaml.bak
# 运行时配置（开关、端口、工具上下线）：随本机状态变，不入库；
# 定义部分（指令、工具清单、站点映射）仍在 *_settings.yaml / config.yaml / custom_tools.yaml 中入库
flask_server/config/remote_bridge_runtime.yaml
flask_server/config/config_runtime.yaml
flask_server/config/custom_tools_runtime.yaml
# 过渡：旧版本服务会在服务根写这些路径，重启后即消失
flask_server/remote_bridge_state.json
flask_server/screenshots/
# 运行时数据产物（截屏、去重记账等）
flask_server/data/
# 语音模型（vosk，体积大且可重新下载，不入库）
models/
# 记忆（工作记忆 + 错题本）：属本地长期沉淀，不入库
memory/
