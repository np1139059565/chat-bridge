-def parse_icenter_url(url: str) -> Tuple[str, str]:
-    """解析iCenter URL，提取spaceId和contentId"""
-    parsed = urlparse(url)
-    fragment = parsed.fragment
-
-    space_shared_match = re.search(r'/(?:space|shared)/([^/]+)', fragment)
-    content_match = re.search(r'/page/([^/]+)', fragment)
-
-    if not space_shared_match or not content_match:
-        raise ValueError(f"Invalid iCenter URL format: {url}")
-
-    space_id = space_shared_match.group(1)
-    content_id = content_match.group(1)
-
-    return space_id, content_id
