-def extract_content_info(data: Dict[str, Any]) -> Dict[str, Any]:
-    """提取内容中的文本、图片、视频"""
-    result = {"text": "", "images": [], "videos": [], "title": "", "summary": ""}
-
-    if "bo" not in data:
-        return result
-
-    bo_data = data["bo"]
-    result["title"] = bo_data.get("title", "")
-    result["summary"] = bo_data.get("summary", "")
-
-    if "contentBody" in bo_data:
-        result["text"] = bo_data["contentBody"]
-        img_pattern = r'<img[^>]+src="([^"]+)"'
-        result["images"] = re.findall(img_pattern, result["text"])
-        video_pattern = r'<video[^>]+src="([^"]+)"'
-        result["videos"] = re.findall(video_pattern, result["text"])
-        source_pattern = r'<source[^>]+src="([^"]+)"'
-        result["videos"].extend(re.findall(source_pattern, result["text"]))
-
-    if "attachments" in bo_data:
-        for attachment in bo_data.get("attachments", []):
-            file_type = attachment.get("fileType", "")
-            file_url = attachment.get("fileUrl", "")
-            if file_type.startswith("image/") and file_url not in result["images"]:
-                result["images"].append(file_url)
-            elif file_type.startswith("video/") and file_url not in result["videos"]:
-                result["videos"].append(file_url)
-
-    return result
