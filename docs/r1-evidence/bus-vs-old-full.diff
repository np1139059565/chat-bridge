-# -*- coding: utf-8 -*-
-"""zxwinmob_tool 容器操作模块：列 Pod、进容器执行命令、拷文件、重启。
-
-设计要点：所有进入容器的动作都走 `kubectl exec -n <ns> <pod> -- <cmd>`，
-`--` 之后才是容器内命令。新版 kubectl 不接受省略 `--` 的写法，
-省略会报 `exec [POD] [COMMAND] is not supported anymore`。
-"""
-import argparse
-import json
-import shlex
-import sys
-
-import zxw_common as common
-
-
-# ==================== Pod 查找 ====================
-
-def find_pod(conn, namespace: str, keyword: str) -> str:
-    """按关键字在命名空间里找第一个匹配的 Pod 名。
-
-    多个 Pod 命中时取排序后的第一个，保证结果稳定可复现。
-    """
-    # --no-headers 去掉表头，让 grep 只看到数据行
-    code, out, err = common.run(
-        conn,
-        common.sudo_cmd("kubectl get pod -n %s --no-headers" % namespace),
-    )
-    if code != 0:
-        raise RuntimeError("查询 Pod 失败: %s" % err.strip())
-    # 逐行筛出名字含关键字的 Pod，取第一列（Pod 名）
-    hits = sorted(
-        line.split()[0]
-        for line in out.splitlines()
-        if keyword in line and line.split()
-    )
-    if not hits:
-        raise RuntimeError("未找到匹配 '%s' 的 Pod" % keyword)
-    return hits[0]
-
-
-# ==================== 容器内执行 ====================
-
-def exec_in_pod(conn, namespace: str, pod: str, command: str, timeout: int = 50):
-    """在 Pod 内执行一条 shell 命令，返回 (退出码, 输出, 错误)。
-
-    命令经 shlex.quote 转义后作为单个参数传给 /bin/sh -c，
-    避免远端 shell 对引号、管道、分号做二次解释。
-    """
-    # 把用户命令交给容器内的 sh 执行；-- 之后全部属于容器内命令
-    inner = "/bin/sh -c %s" % shlex.quote(command)
-    full = common.sudo_cmd(
-        "kubectl exec -n %s %s -- %s" % (namespace, pod, inner)
-    )
-    return common.run(conn, full, timeout=timeout)
-
-
-# ==================== 子命令实现 ====================
-
-def cmd_list_pods(args):
-    """列出命名空间内的 Pod，可按关键字过滤。"""
-    conn = common.open_ssh(common.resolve_host(args.host))
-    try:
-        # -o wide 带上 IP 与所在节点，便于定位
-        code, out, err = common.run(
-            conn,
-            common.sudo_cmd(
-                "kubectl get pod -n %s -o wide" % args.namespace
-            ),
-        )
-        if code != 0:
-            return {"status": "error", "message": err.strip()}
-        lines = out.splitlines()
-        # 第一行是表头，关键字为空时整体返回
-        if args.keyword:
-            lines = [lines[0]] + [l for l in lines[1:] if args.keyword in l]
-        return {"status": "success", "pods": lines}
-    finally:
-        conn.close()
-
-
-def cmd_exec(args):
-    """在指定 Pod 内执行命令。Pod 可给全名，也可给关键字自动匹配。"""
-    conn = common.open_ssh(common.resolve_host(args.host))
-    try:
-        # 给了关键字就现查，否则把 pod 参数当全名
-        pod = find_pod(conn, args.namespace, args.pod) if args.match else args.pod
-        code, out, err = exec_in_pod(
-            conn, args.namespace, pod, args.command, timeout=args.timeout
-        )
-        return {
-            "status": "success" if code == 0 else "error",
-            "pod": pod,
-            "exit_code": code,
-            "stdout": out,
-            "stderr": err,
-        }
-    finally:
-        conn.close()
-
-
-def cmd_ls(args):
-    """列出容器工作目录内容，等价于 exec 的 ls -la。"""
-    args.command = "ls -la %s" % args.path
-    args.match = True
-    args.timeout = 30
-    return cmd_exec(args)
-
-
-def cmd_restart(args):
-    """杀掉容器内 java 进程，交给 start.sh 守护循环按新 jar 拉起。
-
-    注意：容器内 ps 的 PID 在第 1 列（格式 PID USER TIME CMD），
-    不能按常见 Linux 的“第 2 列是 PID”去取，否则拿到的是用户名。
-    """
-    conn = common.open_ssh(common.resolve_host(args.host))
-    try:
-        pod = find_pod(conn, args.namespace, args.pod) if args.match else args.pod
-        # 先取旧 PID，再杀掉，然后轮询等新进程出现
-        script = (
-            "old=$(ps -ef | grep '[j]ava' | awk '{print $1}'); "
-            "echo old_pid=$old; "
-            "[ -n \"$old\" ] && kill -9 $old; "
-            "for i in $(seq 1 30); do sleep 2; "
-            "new=$(ps -ef | grep '[j]ava' | awk '{print $1}'); "
-            "if [ -n \"$new\" ] && [ \"$new\" != \"$old\" ]; then "
-            "echo new_pid=$new; break; fi; done"
-        )
-        code, out, err = exec_in_pod(conn, args.namespace, pod, script, timeout=50)
-        return {
-            "status": "success" if code == 0 else "error",
-            "pod": pod,
-            "detail": out.strip(),
-            "stderr": err.strip(),
-        }
-    finally:
-        conn.close()
-
-
-def cmd_push(args):
-    """把控制器上的文件拷进容器工作目录。"""
-    conn = common.open_ssh(common.resolve_host(args.host))
-    try:
-        pod = find_pod(conn, args.namespace, args.pod) if args.match else args.pod
-        # kubectl cp 源路径用绝对路径，目标为容器内目录
-        full = common.sudo_cmd(
-            "kubectl cp %s %s:%s/ -n %s"
-            % (args.src, pod, args.dest_dir, args.namespace)
-        )
-        code, out, err = common.run(conn, full, timeout=50)
-        return {
-            "status": "success" if code == 0 else "error",
-            "pod": pod,
-            "stdout": out.strip(),
-            "stderr": err.strip(),
-        }
-    finally:
-        conn.close()
-
-
-# ==================== 入口 ====================
-
-def main() -> int:
-    """解析子命令并分发；结果以 JSON 打到标准输出，供工具层规整。"""
-    parser = argparse.ArgumentParser(description="zxwinmob 容器操作")
-    sub = parser.add_subparsers(dest="action", required=True)
-
-    def add_common(p):
-        """给各子命令挂上通用的主机与命名空间参数。"""
-        p.add_argument("--host", required=True, help="主机别名 69/86/102 或 IP")
-        p.add_argument("--namespace", default=common.get_setting("namespace"))
-
-    p = sub.add_parser("list-pods", help="列出 Pod")
-    add_common(p)
-    p.add_argument("--keyword", default="", help="按关键字过滤")
-
-    p = sub.add_parser("exec", help="在容器内执行命令")
-    add_common(p)
-    p.add_argument("--pod", required=True, help="Pod 全名或匹配关键字")
-    p.add_argument("--command", required=True, help="容器内命令")
-    p.add_argument("--match", action="store_true", help="把 pod 当关键字现查")
-    p.add_argument("--timeout", type=int, default=45)
-
-    p = sub.add_parser("ls", help="列出容器工作目录")
-    add_common(p)
-    p.add_argument("--pod", required=True)
-    p.add_argument("--path", default=common.get_setting("container_workdir"))
-
-    p = sub.add_parser("restart", help="重启容器内 java 进程")
-    add_common(p)
-    p.add_argument("--pod", required=True)
-    p.add_argument("--match", action="store_true")
-
-    p = sub.add_parser("push", help="拷文件进容器")
-    add_common(p)
-    p.add_argument("--pod", required=True)
-    p.add_argument("--src", required=True, help="控制器上的源文件路径")
-    p.add_argument("--dest_dir", default=common.get_setting("container_workdir"))
-    p.add_argument("--match", action="store_true")
-
-    args = parser.parse_args()
-    handler = {
-        "list-pods": cmd_list_pods,
-        "exec": cmd_exec,
-        "ls": cmd_ls,
-        "restart": cmd_restart,
-        "push": cmd_push,
-    }[args.action]
-    try:
-        print(json.dumps(handler(args), ensure_ascii=False))
-        return 0
-    except Exception as exc:
-        print(json.dumps({"status": "error", "message": str(exc)}, ensure_ascii=False))
-        return 1
-
-
-if __name__ == "__main__":
-    sys.exit(main())
