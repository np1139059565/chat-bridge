-    def _filter_sections(self, html_content: str,
-                        include_sections: List[str] = None,
-                        exclude_sections: List[str] = None) -> str:
-        """根据章节名称过滤内容"""
-        if not html_content:
-            return html_content
-
-        soup = BeautifulSoup(html_content, 'html.parser')
-        headings = soup.find_all(['h1', 'h2', 'h3', 'h4', 'h5', 'h6'])
-
-        if not headings:
-            return html_content
-
-        sections = []
-        for i, heading in enumerate(headings):
-            sections.append({
-                'level': int(heading.name[1]),
-                'title': heading.get_text().strip(),
-                'element': heading,
-                'next': headings[i + 1] if i + 1 < len(headings) else None
-            })
-
-        exclude_indices = set()
-        if exclude_sections:
-            for i, section in enumerate(sections):
-                for pattern in exclude_sections:
-                    if pattern.lower() in section['title'].lower():
-                        exclude_indices.add(i)
-                        for j in range(i + 1, len(sections)):
-                            if sections[j]['level'] > section['level']:
-                                exclude_indices.add(j)
-                            else:
-                                break
-                        break
-
-        include_indices = set()
-        if include_sections:
-            for i, section in enumerate(sections):
-                for pattern in include_sections:
-                    if pattern.lower() in section['title'].lower():
-                        include_indices.add(i)
-                        for j in range(i + 1, len(sections)):
-                            if sections[j]['level'] > section['level']:
-                                include_indices.add(j)
-                            else:
-                                break
-                        break
-        else:
-            include_indices = set(range(len(sections)))
-
-        final_indices = include_indices - exclude_indices
-
-        filtered = BeautifulSoup('<div></div>', 'html.parser')
-        container = filtered.div
-
-        for i in sorted(final_indices):
-            section = sections[i]
-            new_heading = filtered.new_tag(section['element'].name)
-            new_heading.string = section['title']
-            container.append(new_heading)
-
-            start = section['element'].next_sibling
-            end = section['next']
-
-            while start and start != end:
-                if hasattr(start, 'name') and start.name and start.name.startswith('h'):
-                    break
-                if hasattr(start, 'name'):
-                    container.append(start.extract())
-                elif isinstance(start, NavigableString) and str(start).strip():
-                    container.append(filtered.new_string(str(start)))
-                start = start.next_sibling
-
-        return str(container)
