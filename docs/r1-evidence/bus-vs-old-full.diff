-"""zxwinmob_tool 公共模块：配置、主机解析与 SSH 通道。
-
-本模块只提供最底层能力——读配置、把主机别名换成 IP、建立 SSH 连接、
-执行远程命令并取回输出。上层业务（列 Pod、进容器、部署）都建立在这几个函数上。
-
-为什么单独抽出来：容器操作与部署两个模块都要连同一批控制器，
-连接参数、sudo 前缀、输出解码这些细节若各写一份，改一处就要改两处。
-"""
-import json
-import os
-
-import paramiko
-
-# 脚本所在目录，用于定位同级的 config.json
-_SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
-
-
-# ==================== 配置 ====================
-
-def load_config() -> dict:
-    """读取同目录下的 config.json。
-
-    文件缺失时返回空字典，由调用方回落到内置默认值，
-    保证技能在未放置配置文件时仍指向三台已知环境。
-    """
-    cfg_path = os.path.join(_SCRIPT_DIR, "config.json")
-    # 文件存在才读，缺失不报错
-    if os.path.isfile(cfg_path):
-        with open(cfg_path, "r", encoding="utf-8") as f:
-            return json.load(f)
-    return {}
-
-
-# 内置默认值：配置文件未覆盖时使用
-_DEFAULTS = {
-    "user": "ubuntu",                       # 控制器统一登录名
-    "password": "UbuntU1!2@3#4$",            # 控制器统一密码
-    "namespace": "ranoss",                   # 业务命名空间
-    "container_workdir": "/home/zxwinmob",   # 容器内工作目录
-    "remote_workdir": "/home/ubuntu/lcy",    # 控制器上存放安装包的目录
-    "hosts": {                               # 主机别名 -> IP
-        "69": "10.227.105.69",
-        "86": "10.227.105.86",
-        "102": "10.220.50.102",
-        "192": "10.232.56.192",   # 新环境控制器（paas-controller-1）
-    },
-}
-
-
-def get_setting(key: str):
-    """取单项配置：配置文件的同名字段优先，否则用内置默认值。"""
-    cfg = load_config()
-    return cfg.get(key, _DEFAULTS.get(key))
-
-
-def resolve_host(alias: str) -> str:
-    """把主机别名（69 / 86 / 102）换成 IP；已是 IP 则原样返回。
-
-    别名表来自配置文件的 hosts 段，缺省用内置表。
-    """
-    hosts = get_setting("hosts") or {}
-    # 别名命中则换 IP，否则当作 IP 或主机名直接用
-    return hosts.get(alias, alias)
-
-
-# ==================== SSH 通道 ====================
-
-def open_ssh(ip: str, timeout: int = 15) -> paramiko.SSHClient:
-    """建立到控制器的 SSH 连接并返回客户端对象。
-
-    主机指纹一律自动接受（内网控制器，不做严格校验）。
-    """
-    client = paramiko.SSHClient()
-    # 内网环境：未知主机指纹直接接受，避免交互式确认
-    client.set_missing_host_key_policy(paramiko.AutoAddPolicy())
-    client.connect(
-        ip,
-        username=get_setting("user"),
-        password=get_setting("password"),
-        timeout=timeout,
-    )
-    return client
-
-
-def run(conn: paramiko.SSHClient, command: str, timeout: int = 55):
-    """在远端执行一条命令，返回 (退出码, 标准输出, 标准错误)。
-
-    timeout 默认 55 秒——低于工具层 60 秒上限，留出回传余量。
-    """
-    _, stdout, stderr = conn.exec_command(command, timeout=timeout)
-    # 读出全部输出并解码；非法字节用替换符兜底，避免抛异常
-    out = stdout.read().decode("utf-8", errors="replace")
-    err = stderr.read().decode("utf-8", errors="replace")
-    # 退出码要在读完之后取，否则可能拿到 None
-    code = stdout.channel.recv_exit_status()
-    return code, out, err
-
-
-def sudo_cmd(command: str) -> str:
-    """把一条命令包装成带密码的 sudo 调用。
-
-    远端 ubuntu 用户执行 kubectl 需要 sudo，而 ssh 通道没有终端，
-    必须用 sudo -S 从标准输入喂密码。
-    """
-    pwd = get_setting("password")
-    # 用单引号包住密码，避免特殊字符被 shell 解释
-    return "echo '%s' | sudo -S %s" % (pwd, command)
