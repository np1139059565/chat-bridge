-    def crawl_recursive(self, url: str, current_depth: int, max_depth: int,
-                       output_dir: str, version: str = "1.0",
-                       include_sections: List[str] = None,
-                       exclude_sections: List[str] = None):
-        """递归抓取页面"""
-        if current_depth > max_depth:
-            return
-
-        indent = '  ' * (current_depth - 1)
-        logger.info(f"{indent}[Depth {current_depth}] Processing: {url}")
-
-        html_content, title = self.get_html_content(url, version)
-        space_id, content_id = parse_icenter_url(url)
-
-        if not html_content:
-            logger.warning(f"{indent}获取内容失败，尝试获取子页面列表")
-            self._crawl_subpages_fallback(space_id, content_id, current_depth, max_depth, output_dir, version)
-            return
-
-        safe_title = re.sub(r'[\\/:*?"<>|]', '_', title or f'page_depth_{current_depth}')
-        md_file = os.path.join(output_dir, f"{safe_title}.md")
-
-        children_links = self.get_children_links(space_id, content_id, html_content, version)
-        html_with_links = self.replace_macro_with_links(html_content, children_links)
-
-        if include_sections or exclude_sections:
-            html_with_links = self._filter_sections(html_with_links, include_sections, exclude_sections)
-
-        # 附件相对链接补全为可点击地址
-        html_with_links = self.fix_attachment_links(html_with_links)
-
-        markdown_content = self.convert_html_to_markdown(html_with_links)
-        self.save_markdown(markdown_content, md_file, title)
-
-        if children_links and current_depth < max_depth:
-            next_dir = os.path.join(output_dir, f"depth_{current_depth + 1}")
-            os.makedirs(next_dir, exist_ok=True)
-
-            for _, sub_url in children_links:
-                self.crawl_recursive(sub_url, current_depth + 1, max_depth, next_dir, version,
-                                    include_sections, exclude_sections)
-
-    def _crawl_subpages_fallback(self, space_id: str, content_id: str,
