-            if target is None:
-                sys.stderr.write(f'未找到引用块: {block_id} in {doc_id}\n')
-                continue
-            inner = self.inline(self.section_html(target), depth + 1)
-            macro.replace_with(BeautifulSoup(inner, 'html.parser'))
-        return str(soup)
