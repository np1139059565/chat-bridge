-
-
-HEADING_LEVELS = {'h1': 1, 'h2': 2, 'h3': 3, 'h4': 4, 'h5': 5, 'h6': 6}
-
-
-class Inliner:
-    def __init__(self, client, space_id):
-        self.client = client
-        self.space_id = space_id
