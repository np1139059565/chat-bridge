-def _probe_api_versions(client: ICenterClient, space_id: str, content_id: str) -> Dict[str, Any]:
-    """探测指定空间与内容在 1.0 / 2.0 两套 API 上的可用性
-
-    下载与新建都需要判断目标空间走哪套接口，这里把判定逻辑集中一处，
-    供 detect_version（按 URL 探测）与 create_content（按父页面探测）共用。
-    """
-    # 先试 1.0 接口：能拿到 bo 或返回码 0000，即认为该接口可用
-    api_url_1_0 = client.build_api_url("1.0", f"content/{content_id}", spaceId=space_id)
-    try:
-        data_1_0 = client.make_request('GET', api_url_1_0, "1.0").json()
-        is_1_0_available = "bo" in data_1_0 or data_1_0.get("code", {}).get("code") == "0000"
-    except Exception:
-        # 请求异常视为该版本不可用
-        is_1_0_available = False
-        data_1_0 = None
-
-    # 再试 2.0 接口，判定规则与 1.0 一致
-    api_url_2_0 = client.build_api_url("2.0", f"content/{content_id}", spaceId=space_id)
-    try:
-        data_2_0 = client.make_request('GET', api_url_2_0, "2.0").json()
-        is_2_0_available = "bo" in data_2_0 or data_2_0.get("code", {}).get("code") == "0000"
-    except Exception:
-        is_2_0_available = False
-        data_2_0 = None
-
-    # 只有 1.0 可用则取 1.0，只有 2.0 可用则取 2.0
-    if is_1_0_available and not is_2_0_available:
-        version = "1.0"
-    elif is_2_0_available and not is_1_0_available:
-        version = "2.0"
-    elif is_1_0_available and is_2_0_available:
-        # 两套都通时优先 2.0；若 2.0 返回 0006（未授权），说明实际只走 1.0
-        if data_2_0 and data_2_0.get("code", {}).get("code") == "0006":
-            version = "1.0"
-        else:
-            version = "2.0"
-    else:
-        # 两套都不可用，交由调用方决定如何处理
-        version = "unknown"
-
-    return {
-        "version": version,
-        "space_id": space_id,
-        "content_id": content_id,
-        "1.0_available": is_1_0_available,
-        "2.0_available": is_2_0_available
-    }
-
-
-def detect_version(url: str, client: ICenterClient) -> Dict[str, Any]:
-    """检测iCenter URL对应的空间版本"""
-    try:
-        # 从 URL 中拆出空间与内容标识
-        space_id, content_id = parse_icenter_url(url)
-        logger.info(f"开始检测URL版本: {url}, space_id={space_id}, content_id={content_id}")
-
-        # 复用统一的探测逻辑
-        result = _probe_api_versions(client, space_id, content_id)
-        logger.info(f"版本检测完成: {result['version']}, 1.0={result['1.0_available']}, 2.0={result['2.0_available']}")
-        return result
-
-    except Exception as e:
-        logger.error(f"版本检测失败: {str(e)}")
-        return {"error": str(e)}
