-# -*- coding: utf-8 -*-
-"""zxwinmob_tool 部署模块：把 web 安装包打进容器 cclo.jar 并重启进程。
-
-为什么拆成 start / status 两步：
-工具层对脚本有 60 秒硬上限，超时会 taskkill /T 杀整棵进程树，
-脚本内起后台进程也活不下来。所以把真正的部署动作用 nohup 扔到
-远端控制器上跑，本机只在几秒内启动它、并在之后按任务号查询结果。
-
-部署的真实步骤（照 dcp.sh 的实践）：
-  1. kubectl cp 把 zip 送进容器工作目录
-  2. 容器内备份 cclo.jar，解出 static 目录
-  3. 解压 zip，用包里的 web 覆盖 static/covoptsol/web
-  4. jar uf 把新 web 打回 cclo.jar
-  5. 杀掉 java 进程，start.sh 守护循环会用新 jar 自动拉起
-"""
-import argparse
-import json
-import shlex
-import sys
-import time
-import uuid
-
-import zxw_common as common
-
-
-# 远端脚本与日志的存放目录：放在控制器上，供后台任务读写
-_REMOTE_DIR = "/home/ubuntu/lcy/zxw_deploy"
-
-
-# ==================== 远端部署脚本 ====================
-
-def _build_remote_script(params: dict) -> str:
-    """生成在控制器上后台执行的 bash 脚本全文。
-
-    脚本自己负责 kubectl cp、容器内打包、重启，并把过程写进日志文件，
-    结束时把 SUCCESS / FAILED 写进状态文件，供 status 子命令读取。
-    """
-    ns = params["namespace"]
-    pod = params["pod"]
-    zip_name = params["zip_name"]
-    workdir = params["workdir"]
-    remote_zip = "%s/%s" % (params["remote_dir"], zip_name)
-    pwd = params["password"]
-    # 容器内执行的一整段部署逻辑，用单引号包好后作为 sh -c 的参数
-    inner = (
-        "cd {wd} && "
-        "cp -f cclo.jar cclo.jar.bak && "
-        "jar xf cclo.jar static && "
-        "unzip -o {zip} >/dev/null && "
-        "rm -rf static/covoptsol/web && "
-        "cp -r runtime/apps/*/web static/covoptsol/ && "
-        "jar uf cclo.jar static/covoptsol/web && "
-        "echo jar_entries=$(jar tf cclo.jar | grep -c covoptsol/web) && "
-        "rm -rf {zip} source/ runtime/ && "
-        "old=$(ps -ef | grep '[j]ava' | awk '{{print $1}}') && "
-        "echo old_pid=$old && "
-        "kill -9 $old && "
-        "for i in $(seq 1 30); do sleep 2; "
-        "new=$(ps -ef | grep '[j]ava' | awk '{{print $1}}'); "
-        "if [ -n \"$new\" ] && [ \"$new\" != \"$old\" ]; then echo new_pid=$new; break; fi; done"
-    ).format(wd=workdir, zip=shlex.quote(zip_name))
-    # 组装完整脚本：先拷包，再进容器部署，最后写状态标记
-    script = f"""#!/bin/bash
-LOG={_REMOTE_DIR}/{params['task_id']}.log
-STATUS={_REMOTE_DIR}/{params['task_id']}.status
-exec > "$LOG" 2>&1
-echo "[start] $(date '+%F %T') pod={pod}"
-
-echo "{pwd}" | sudo -S kubectl cp {remote_zip} {pod}:{workdir}/ -n {ns}
-if [ $? -ne 0 ]; then echo FAILED > "$STATUS"; echo "[error] kubectl cp failed"; exit 1; fi
-echo "[ok] copied into pod"
-
-echo "{pwd}" | sudo -S kubectl exec -n {ns} {pod} -- /bin/sh -c {shlex.quote(inner)}
-rc=$?
-if [ $rc -ne 0 ]; then echo FAILED > "$STATUS"; echo "[error] deploy inner rc=$rc"; exit 1; fi
-echo "[ok] deploy done"
-echo SUCCESS > "$STATUS"
-echo "[end] $(date '+%F %T')"
-"""
-    return script
-
-
-# ==================== 子命令 ====================
-
-def _ensure_zip_on_target(target_conn, args):
-    """确保安装包在目标控制器的 remote_workdir 下。
-
-    包若不在目标机（例如包在 102、部署到 69），用 SFTP 从源机中转过来。
-    返回 (是否就绪, 错误信息)。
-    """
-    remote_dir = common.get_setting("remote_workdir")
-    target_path = "%s/%s" % (remote_dir, args.zip_name)
-    # 目标机已有同名包则直接用
-    code, _, _ = common.run(target_conn, "ls %s 2>/dev/null" % target_path)
-    if code == 0:
-        return True, ""
-    # 未指定源主机：包应在本机却没有，直接报错
-    src_host = args.zip_host or args.host
-    src_ip = common.resolve_host(src_host)
-    tgt_ip = common.resolve_host(args.host)
-    if src_ip == tgt_ip:
-        return False, "控制器 %s 上不存在 %s" % (src_host, args.zip_name)
-    # 跨机中转：源机读 -> 目标机写，用同一份内存流搬运
-    src_conn = common.open_ssh(src_ip)
-    try:
-        sftp_src = src_conn.open_sftp()
-        src_path = "%s/%s" % (remote_dir, args.zip_name)
-        try:
-            src_file = sftp_src.open(src_path, "rb")
-        except IOError:
-            return False, "源主机 %s 上不存在 %s" % (src_host, args.zip_name)
-        try:
-            sftp_tgt = target_conn.open_sftp()
-            try:
-                tgt_file = sftp_tgt.open(target_path, "wb")
-                # 分块搬运，避免一次读入整包占内存
-                while True:
-                    chunk = src_file.read(1024 * 1024)
-                    if not chunk:
-                        break
-                    tgt_file.write(chunk)
-                tgt_file.close()
-            finally:
-                sftp_tgt.close()
-        finally:
-            # 源文件句柄无论成功失败都要关，防止句柄泄漏
-            src_file.close()
-        return True, ""
-    finally:
-        src_conn.close()
-
-
-def cmd_start(args):
-    """在控制器后台启动一次部署，立即返回任务号。"""
-    conn = common.open_ssh(common.resolve_host(args.host))
-    try:
-        # 先确保包已就位；缺失或不一致直接返回，不浪费一次后台任务
-        ok, msg = _ensure_zip_on_target(conn, args)
-        if not ok:
-            return {"status": "error", "message": msg}
-        # 关键字模式下现查 Pod 全名
-        pod = args.pod
-        if args.match:
-            import zxw_container  # 延迟导入，避免循环依赖
-            code, out, err = common.run(
-                conn, common.sudo_cmd("kubectl get pod -n %s --no-headers" % args.namespace)
-            )
-            hits = sorted(l.split()[0] for l in out.splitlines() if args.pod in l and l.split())
-            if not hits:
-                return {"status": "error", "message": "未找到匹配 '%s' 的 Pod" % args.pod}
-            pod = hits[0]
-        task_id = "zxw_%s_%s" % (time.strftime("%Y%m%d%H%M%S"), uuid.uuid4().hex[:6])
-        params = {
-            "namespace": args.namespace, "pod": pod, "zip_name": args.zip_name,
-            "workdir": common.get_setting("container_workdir"),
-            "remote_dir": common.get_setting("remote_workdir"),
-            "password": common.get_setting("password"), "task_id": task_id,
-        }
-        script = _build_remote_script(params)
-        # 落盘脚本并以 nohup 后台启动：setsid 脱离当前会话，ssh 断开不影响
-        local_sh = "/tmp/%s.sh" % task_id
