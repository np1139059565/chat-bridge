-        if doc_id not in self.cache:
-            api = self.client.build_api_url('1.0', 'content/' + doc_id, spaceId=self.space_id)
-            resp = self.client.session.get(
-                api,
-                headers=self.client._get_headers_v1(),
-                proxies={'http': '', 'https': ''},
-            )
-            self.cache[doc_id] = resp.json()['bo'].get('contentBody', '')
-        return self.cache[doc_id]
-
-    @staticmethod
-    def find_target(soup, block_id):
-        """定位被引用块。匹配 block-id，或锚点属性（大小写不敏感）。
-
-        BeautifulSoup 会把属性名转小写，故需小写比较。
-        """
-        target = soup.find(attrs={'block-id': block_id})
-        if target is not None:
-            return target
-        bid = block_id.lower()
-        wanted = {'anchor-' + bid, 'reference-' + bid}
-        for el in soup.find_all(True):
-            for attr in el.attrs:
-                if attr.lower() in wanted:
-                    return el
-        return None
-
-    @staticmethod
-    def section_html(el):
-        """若目标是标题，连其下内容一并取出（直到同级或更高级标题）。"""
