{
  "tools": [
    {
      "name": "json_validate",
      "description": "校验并格式化 JSON 文本：返回美化后的 JSON；非法 JSON 返回错误。用于核对 AI 生成的 JSON 片段。",
      "script": "scripts/json_validate.py",
      "interpreter": "python",
      "arg_style": "flag",
      "parameters": [
        { "name": "text", "type": "string", "required": true, "description": "待校验的 JSON 文本" },
        { "name": "indent", "type": "number", "required": false, "description": "缩进空格数，默认 2" },
        { "name": "sort_keys", "type": "boolean", "required": false, "description": "是否按 key 排序" }
      ]
    }
  ]
}
