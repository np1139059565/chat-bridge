{
  "manifest_version": 2,
  "name": "AI Bridge 诊断工具",
  "version": "0.1.0",
  "description": "验证手机 Firefox 上自建扩展能否注入网页、操作输入框、抓取 AI 回答、连通本地服务",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "<all_urls>",
    "storage"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ai-bridge-diag@local.test",
      "strict_min_version": "115.0"
    }
  }
}
